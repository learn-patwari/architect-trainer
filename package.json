{
  "name": "architect-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "System design interview trainer: HLD/LLD, concepts, tools reference, and deterministic diagram rubric scoring.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundle": "vite build && vitest run tests/bundle-secrecy.test.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
